{
  "name": "agenda-de-contatos",
  "version": "2.0.0",
  "private": true,
  "description": "Agenda de Contatos — Connected Universe (Ryan Leal Edition). Aplicação web segura, acessível e responsiva para gerenciamento local de contatos.",
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.5",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "gsap": "^3.12.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  }
}
